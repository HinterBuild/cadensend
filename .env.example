# Database
# Set to your PostgreSQL connection string
# DATABASE_URL=postgres://user:pass@localhost:5432/dbname
REDIS_URL=redis://localhost:6379/0

# Vector Store (RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Object Storage
MINIO_ENDPOINT=localhost:9000
# Set from your MinIO console
# MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=cadensend

# AI Model (default: free model via OpenRouter)
OPENROUTER_API_KEY=
DEFAULT_MODEL=poolside/laguna-s-2.1:free

# Email (optional - for delivery)
SMTP_FROM=no-reply@cadensend.app
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# Security
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256

# Environment
ENVIRONMENT=development
DEBUG=true
