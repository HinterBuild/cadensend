# Database
DATABASE_URL=postgres://cadensend:cadensend@localhost:5432/cadensend?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Vector Store (RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=cadensend

# AI LLM Providers (multi-provider support)
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=poolside/laguna-s-2.1:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# xAI Grok
XAI_API_KEY=
XAI_MODEL=grok-2-128k

# Qwen
QWEN_API_KEY=
QWEN_MODEL=qwen-turbo

# Local LLM (Ollama, llama.cpp, etc.)
LOCAL_BASE_URL=http://localhost:11434
LOCAL_MODEL=llama3

# Email (from environment; used for test previews and scheduled sends)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3
SMTP_FROM=
SMTP_FROM_NAME=Cadensend

# Security - CHANGE in production
JWT_SECRET=dev-secret-change-in-production
INTERNAL_API_TOKEN=dev-internal-token-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=24h

# Environment
ENVIRONMENT=development
DEBUG=true

# PostgreSQL (for docker-compose)
POSTGRES_USER=cadensend
POSTGRES_PASSWORD=cadensend

# MinIO (for docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Observability (optional)
GRAFANA_ADMIN_PASSWORD=change-me-monitoring-admin

# Contact / Support
# Issue tracker: https://github.com/HinterBuild/cadensend/issues
# Discord: https://discord.gg/cadensend
